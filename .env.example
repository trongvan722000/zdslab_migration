# Copy to .env (never commit .env):   cp .env.example .env && chmod 600 .env
# docker compose reads .env from this folder automatically. Wrap values in SINGLE quotes so a `$` or `#`
# inside a secret is kept literally (unquoted/double-quoted values are interpolated by compose).

# ---------------------------------------------------------------- Superset secret keys (REQUIRED)
# Practice lab: any long random string works (openssl rand -base64 42), but each lab must use its own.
# Rehearsal with a real dump: MUST be the real SECRET_KEY of that lab, otherwise Superset fails with
# "ValueError: Invalid decryption key" (dbs.password / encrypted_extra are encrypted with it).
# Changing a key on an existing lab makes its stored connection passwords unreadable.
SUPERSET_SECRET_KEY_LAB1='zdslab1_secret_key_change_me_1111111111'
SUPERSET_SECRET_KEY_LAB2='zdslab2_secret_key_change_me_2222222222'

# ---------------------------------------------------------------- Versions / images
SUPERSET_VERSION_LAB1=2.1.1
SUPERSET_VERSION_LAB2=5.0.0
# Lab 1 metadata engine. Real Lab 1 is MariaDB 10.3.32; the real dump only restores into MariaDB.
# Changing it requires removing the mysql_lab1 volume.
LAB1_META_IMAGE=mariadb:10.3.32
# Image the Dockerfile copies prebuilt MySQLdb/psycopg2 from (for networks without apt/pip access).
SUPERSET_DRIVER_SOURCE_IMAGE=apachesuperset.docker.scarf.sh/apache/superset:4.1.1-dev

# ---------------------------------------------------------------- Host ports (change if already taken)
MYSQL_LAB1_PORT=3307
POSTGRES_LAB1_PORT=5433
POSTGRES_LAB2_PORT=5434
SUPERSET_LAB1_PORT=8088
SUPERSET_LAB2_PORT=8089



